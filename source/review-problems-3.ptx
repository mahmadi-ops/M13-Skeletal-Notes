  <annotation ref="ca-grad" text="The gradient at one comma two, perpendicular to the level curve and pointing toward larger values of f."/>
  <annotation ref="ca-u2" text="The vector u two at P, pointing straight down toward smaller values of f, so the directional derivative there is negative."/>

            <label anchor="(0.8, 0)" alignment="s" offset="(6,-2)"><m>x \gt 0</m></label>
          </group>
          <group at="pos-sample">
            <line p1="(0.5, 0)" p2="(0.5, f(0.5))" dash="4 4" stroke="olive" thickness="1"/>
            <label anchor="(0.5, 0)" alignment="s" offset="(-4,-2)" color="olive"><m>c</m></label>
            <point p="(0.5, f(0.5))" fill="olive" size="4"/>

          <line p1="(0, -cos(theta))" p2="bob" dash="4 4" stroke="gray" thickness="1"/>
          <label anchor="(0.5*bob[0], -cos(theta))" alignment="n" offset="(0,3)"><m>\ell\sin\theta</m></label>
          <label anchor="(0.25, -0.9)" alignment="s"><m>x</m></label>
          <line at="FT" p1="bob" p2="ftEnd" stroke="magenta" thickness="3" arrows="1"/>

          <line at="mgcos" p1="bob" p2="cosEnd" dash="4 3" stroke="magenta" thickness="2" arrows="1"/>
          <label anchor="cosEnd" alignment="se" offset="(4.7,-2)"><m>mg\cos\theta</m></label>
          <point p="bob" fill="green" size="9"/>

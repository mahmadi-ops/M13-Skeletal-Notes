        </coordinates>
        <annotations>
          <annotation ref="string"
              text="A simple pendulum: a bob of mass m on a string of length l making an angle theta with the vertical. The weight m g points straight down and is resolved into two components: m g cosine theta along the string, balanced by the tension F sub T, and m g sine theta tangent to the arc, which is the restoring force driving the motion">
            <annotation ref="string" text="The string of length l at angle theta from the vertical"/>
            <annotation ref="FT" text="The tension F sub T, directed along the string toward the pivot" sonify="yes"/>
            <annotation ref="mgvec" text="The weight m g, directed straight down" sonify="yes"/>
            <annotation ref="mgsin" text="The tangential component m g sine theta, the restoring force" sonify="yes"/>

  % the point P0
  \fill[red] (1.5708,1,0) circle (2pt) node[below left=2pt, red] {$P_0\!\left(\frac{\pi}{2},1,0\right)$};
  % the normal vector at P0, direction (1, pi/2, 1)/|.| * 0.95
  \draw[-stealth, mblue, very thick] (1.5708,1,0) ]]>&#45;&#45;<![CDATA[ (2.0146,1.6971,0.4438)
        node[below right=3pt] {$\vec n=\left\langle 1,\frac{\pi}{2},1\right\rangle$};

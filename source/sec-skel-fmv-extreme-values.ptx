<asymptote label="asymptote-skel-ev-critical-point-cone"><![CDATA[
// The cone z = sqrt(x^2 + y^2), drawn as in the full notes but without the
// trace z = |x| and its corner, which are the answer to the example.
import graph3;
// Keep HTML interactive; use vector rendering only for print output.
if(settings.outformat != "html") settings.render=0;
size(11cm,9cm);
currentprojection=orthographic(camera=(7,-5,4),up=Z);
currentlight=light(gray(0.6),specularfactor=0.2,(4,-3,6),(-4,-1,3));
pen ax=gray(0.25)+linewidth(0.6pt);

// the cone over the disc of radius 1.6
triple cone(pair q) { return (q.x*cos(q.y), q.x*sin(q.y), q.x); }
draw(surface(cone, (0, 0), (1.6, 2pi), 8, 24, Spline),
     surfacepen=gray(0.75)+opacity(0.35),
     meshpen=gray(0.55)+opacity(0.4)+linewidth(0.3pt));
label("$z=f(x,y)$", cone((1.6, 1.2)), E, gray(0.4));

draw(Label("$x$",1),(-2,0,0)--(2.4,0,0),ax,Arrow3);
draw(Label("$y$",1),(0,-2,0)--(0,2.4,0),ax,Arrow3);
draw(Label("$z$",1),O--(0,0,2.3),ax,Arrow3);
]]></asymptote>
</image>
</figure>

</subsection>


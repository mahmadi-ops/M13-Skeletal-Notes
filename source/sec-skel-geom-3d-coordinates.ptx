    (R4) to[out=-20,in=-20,looseness=1.5] % tip
    (R5) --
    (R6) to[out=140,in=8,looseness=0.9]
    (R7)
    (R2) to[out=-160,in=155] % PINKY
    (P1) to[out=-35,in=150]
    (P2) to[out=-30,in=160]

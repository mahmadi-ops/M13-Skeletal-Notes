  \draw[magenta, thick] (O) ++ (148:0.55) --++ (188:0.55) --++ (-32:0.55); % x and y
  \draw[magenta, thick] (O) ++ ( 82:0.55) --++ (148:0.55) --++ (-98:0.55); % z and x

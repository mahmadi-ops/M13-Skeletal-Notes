    (I4) to[out=-30,in=105]
    (I5) to[out=-75,in=90]
    (I6)
    (I5) to[out=-170,in=10] % MIDDLE
    (M1) to[out=-170,in=10]
    (M2) to[out=-170,in=-175,looseness=1.8] % tip
    (M3) to[out=5,in=-170]
    (M4) to[out=10,in=-170] % bottom knuckle
    (M5)
    (M5) to[out=-160,in=50] % RING
    (R1) to[out=-130,in=140,looseness=1.2]
    (R2) to[out=-30,in=160]

Context()->strings->add(
  "A" => {}, "B" => {}, "C" => {},
  "D" => {}, "E" => {}, "F" => {},
);
$match1 = String("E");
$match2 = String("B");
$match3 = String("D");
$match4 = String("C");
# Until Assignment 7's solutions are released, each blank is graded by a
# checker whose displayed correct answer is empty, so WeBWorK reports no
# answer for the page to print; grading still uses match1 to match4.
$ev1 = $match1->cmp(correct_ans => "", correct_ans_latex_string => "");
$ev2 = $match2->cmp(correct_ans => "", correct_ans_latex_string => "");
$ev3 = $match3->cmp(correct_ans => "", correct_ans_latex_string => "");
$ev4 = $match4->cmp(correct_ans => "", correct_ans_latex_string => "");

############################################################
# Body
############################################################

BEGIN_PGML
Match the equations of the surfaces with the graphs A[$NDASH]*F shown above by entering a letter from A to F in each blank.

[`y = 2x^2 + z^2`] matches graph [_]{$ev1}{4}.

[`y^2 = x^2 + 2z^2`] matches graph [_]{$ev2}{4}.

[`x^2 + 2z^2 = 1`] matches graph [_]{$ev3}{4}.

[`y = x^2 - z^2`] matches graph [_]{$ev4}{4}.

END_PGML

